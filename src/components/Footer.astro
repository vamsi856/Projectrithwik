---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { logo: ImageMetadata; tone: 'bird' | 'food'; brand: string; gstin: string; sister: { view: string; href: string; text: string } }
const { logo, tone, brand, gstin, sister } = Astro.props;
---
<footer class:list={['foot', tone === 'food' && 'foot--food']}>
  <Image class="foot__logo" src={logo} alt={brand} width={128} height={128} loading="lazy" />
  <p><b>{brand}</b>, Kurnool, Andhra Pradesh. GSTIN {gstin}</p>
  <p class="foot__sister">Also from our family: <a href={sister.href} data-switch={sister.view}>{sister.text}</a></p>
  <p class="foot__small">&copy; <span data-year>2026</span> {brand}. <a href="#" data-book>Back to the book</a> · <a href="#credits" data-credits>Photo credits</a></p>
</footer>
