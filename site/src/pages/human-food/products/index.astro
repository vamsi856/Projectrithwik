---
import InfoShell from '../../../components/InfoShell.astro';
import InfoProducts from '../../../components/InfoProducts.astro';
import { FOOD, FOOD_GROUPS, BRANDS, lineCount } from '../../../data/products';
import { photo } from '../../../data/photos';
void lineCount;
const SITE = new URL(import.meta.env.BASE_URL, Astro.site).href;
const list = {
  '@type': 'ItemList', '@id': `${SITE}human-food/products/#list`, name: 'Human food products, ' + BRANDS.food.name, numberOfItems: FOOD.length,
  itemListElement: FOOD.map((p, i) => ({ '@type': 'ListItem', position: i + 1, item: { '@type': 'Product', name: p.name, brand: { '@type': 'Brand', name: BRANDS.food.name },
    ...(photo(p.photo) ? { image: new URL(photo(p.photo)!.src, Astro.site).href } : {}),
    description: p.variants.length > 1 ? `${p.name}: ${p.variants.map((v) => v.label).join(', ')}` : p.name } })),
};
---
<InfoShell path="human-food/products/" h1="Human food products" schema={[list]}
  lede={`40+ products for retail packers, traders and bulk buyers across India. Prices change with the crop: ask for today's rate.`}>
  <InfoProducts items={FOOD} groups={FOOD_GROUPS} brand={BRANDS.food.name} />
</InfoShell>
