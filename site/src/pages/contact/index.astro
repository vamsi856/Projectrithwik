---
import InfoShell from '../../components/InfoShell.astro';
import { CONTACT, BRANDS } from '../../data/products';
const SITE = new URL(import.meta.env.BASE_URL, Astro.site).href;
const contact = { '@type': 'ContactPage', '@id': `${SITE}contact/#contact`, url: `${SITE}contact/`, about: { '@id': `${SITE}#family` } };
---
<InfoShell path="contact/" h1="Contact us" schema={[contact]}
  lede={`Call or WhatsApp ${CONTACT.call.label} for today's price, or visit our office in Kurnool.`}>
  <div class="icontact">
    <div class="ibox">
      <h2 style="margin-top:0">Office, Kurnool</h2>
      <dl>
        <div><dt>Address</dt><dd>{CONTACT.office}</dd></div>
        <div><dt>Phone</dt><dd>{CONTACT.phones.map((p, i) => <><a href={`tel:${p.tel}`}>{p.label}</a>{p.note && ` (${p.note})`}{i < CONTACT.phones.length - 1 && ', '}</>)}</dd></div>
        <div><dt>Email</dt><dd><a href={`mailto:${BRANDS.bird.email}`}>{BRANDS.bird.email}</a> ({BRANDS.bird.name})<br /><a href={`mailto:${BRANDS.food.email}`}>{BRANDS.food.email}</a> ({BRANDS.food.name})</dd></div>
      </dl>
      <p><a class="ibtn" href={CONTACT.directions} target="_blank" rel="noopener">Directions to the office</a></p>
      <iframe class="imap" src={CONTACT.map} title="Map of the Rithwik office, Dhanalakshmi Nagar, Kurnool" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
    <div class="ibox">
      <h2 style="margin-top:0">Main warehouse, Duvvur</h2>
      <dl>
        <div><dt>Address</dt><dd>{CONTACT.warehouse}</dd></div>
        <div><dt>WhatsApp</dt><dd><a href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener">{CONTACT.call.label}</a></dd></div>
      </dl>
      <p><a class="ibtn" href={CONTACT.warehouseDirections} target="_blank" rel="noopener">Directions to the warehouse</a></p>
      <iframe class="imap" src={CONTACT.warehouseMap} title="Map of the Rithwik warehouse, Sanjivareddypalle, Duvvur" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
  <h2>Ordering</h2>
  <p>For prices, send the product, the quantity and your delivery town on WhatsApp to 92455 55556; we reply with the day's rate. Rithwik Bird Feeds supplies bird feed to traders, pet shops, bird keepers and export houses; Rithwik Industries supplies millets, super foods, oil seeds, pulses, spices and cereals to retail packers, traders and bulk buyers. Our main warehouse is at Duvvur, and we deliver across India.</p>
</InfoShell>
