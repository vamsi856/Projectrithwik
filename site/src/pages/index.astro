---
import '../styles/site.css';
import '../styles/v2.css';
import { Image } from 'astro:assets';
import birdLogo from '../assets/brand/birdfeeds-emblem.jpg';
import foodLogo from '../assets/brand/industries-emblem.png';
import ProductCard from '../components/ProductCard.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Contact from '../components/Contact.astro';
import Vision from '../components/Vision.astro';
import Steps from '../components/Steps.astro';
import Footer from '../components/Footer.astro';
import { BIRD, FOOD, BIRD_GROUPS, FOOD_GROUPS, BRANDS, CONTACT, lineCount, lineName } from '../data/products';
import { photo, credits } from '../data/photos';
import Photo from '../components/Photo.astro';
import HeroPack from '../components/HeroPack.astro';
import PackStudio from '../components/PackStudio.astro';
import { BIRD_PACKS, FOOD_PACKS } from '../data/packs';
import SeasonClock from '../components/SeasonClock.astro';
import SeedToSack from '../components/SeedToSack.astro';
import { BIRD_SEASONS, FOOD_SEASONS } from '../data/seasons';
import { held } from '../data/registrations';
import Certifications from '../components/Certifications.astro';
import BirdsWeFeed from '../components/BirdsWeFeed.astro';
import Legacy from '../components/Legacy.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const nBird = lineCount(BIRD);
const nFood = lineCount(FOOD);
const birdOptions = BIRD.flatMap((p) => p.variants.map((v) => lineName(p, v)));
const foodOptions = FOOD.flatMap((p) => p.variants.map((v) => lineName(p, v)));
const marquee = (names: string[]) => [...new Set(names)];
const birdHeroPhoto = photo('bird-budgies');
void photo;
const birdAboutPhoto = photo('bird-on-millet');
const birdFlightPhoto = photo('bird-parakeet-flight');
const farmersPhoto = photo('farmers-millet');
const scenes: Record<string, string> = { millets: 'little', seeds: 'quinoab', pantry: 'clove' };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Rithwik, Kurnool: Bird Feeds and Human Food</title>
  <meta name="description" content="Two businesses from Kurnool, Andhra Pradesh. Rithwik Bird Feeds: foxtail, proso, sunflower, jowar and more. Rithwik Industries: millets, super seeds, quinoa, dals and spices." />
  <meta name="theme-color" content="#0b1924" />
  <link rel="canonical" href="https://vamsi856.github.io/Projectrithwik/" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Rithwik, Kurnool" />
  <meta property="og:title" content="Rithwik Bird Feeds & Rithwik Industries, Kurnool" />
  <meta property="og:description" content="Bird feed grains and human food staples from Kurnool, Andhra Pradesh. Millets, sunflower, jowar, super seeds, quinoa, dals and spices." />
  <meta property="og:url" content="https://vamsi856.github.io/Projectrithwik/" />
  <meta property="og:image" content={new URL(`${base}og.jpg`, 'https://vamsi856.github.io').href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="apple-touch-icon" href={`${base}favicon.jpg`} />
  <script type="application/ld+json" set:html={JSON.stringify([
    { '@context': 'https://schema.org', '@type': 'LocalBusiness', name: BRANDS.bird.name, email: BRANDS.bird.email, telephone: '+91 83097 82770', taxID: BRANDS.bird.gstin, url: 'https://vamsi856.github.io/Projectrithwik/#bird-feeds',
      address: { '@type': 'PostalAddress', streetAddress: '87/1404, Dhanalakshmi Nagar, near Nandyal Checkpost', addressLocality: 'Kurnool', addressRegion: 'Andhra Pradesh', postalCode: '518002', addressCountry: 'IN' } },
    { '@context': 'https://schema.org', '@type': 'LocalBusiness', name: BRANDS.food.name, email: BRANDS.food.email, telephone: '+91 83097 82770', taxID: BRANDS.food.gstin, url: 'https://vamsi856.github.io/Projectrithwik/#human-food',
      address: { '@type': 'PostalAddress', streetAddress: '87/1404, Dhanalakshmi Nagar, near Nandyal Checkpost', addressLocality: 'Kurnool', addressRegion: 'Andhra Pradesh', postalCode: '518002', addressCountry: 'IN' } },
  ])} />
  <link rel="icon" href={`${base}favicon.jpg`} />
  <link rel="preload" href={`${base}fonts/anton-latin-400-normal.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}fonts/instrument-sans-latin-400-normal.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}fonts/instrument-sans-latin-600-normal.woff2`} as="font" type="font/woff2" crossorigin />
  <script is:inline>
    // Show the right site before first paint when the link points straight at one.
    (function () { var h = location.hash; document.documentElement.dataset.view = h === '#bird-feeds' ? 'bird' : h === '#human-food' ? 'food' : 'book'; })();
  </script>
</head>
<body data-view="book">

  <!-- ================= THE BOOK ================= -->
  <section class="stage" id="book-view" aria-label="Choose a business">
    <div class="stage__grain" aria-hidden="true"></div>
    <canvas class="stage__dust" aria-hidden="true"></canvas>
    <p class="stage__hint" id="stageHint">Two businesses, one family. Open the book.</p>

    <div class="book" id="book">
      <a class="page page--food" href="#human-food" data-enter="food">
        <div class="page__inner">
          <Image class="page__emblem page__emblem--food" src={foodLogo} alt="" width={300} loading="eager" />
          <div class="page__text">
            <p class="page__kicker">Rithwik Industries</p>
            <h2 class="page__title">Human<br />food</h2>
            <p class="page__lede">Millets, super seeds, quinoa, dals and spices for your kitchen and your shelves.</p>
            <span class="page__count">{nFood} products</span>
            <span class="page__cta">Open Human Food</span>
          </div>
          <span class="page__folio" aria-hidden="true">ii</span>
        </div>
      </a>

      <div class="cover" id="cover">
        <button class="cover__front" id="openBook" type="button" aria-label="Open the book">
          <span class="cover__frame" aria-hidden="true"></span>
          <span class="cover__emblems" aria-hidden="true">
            <Image src={birdLogo} alt="" width={260} loading="eager" />
            <Image src={foodLogo} alt="" width={260} loading="eager" />
          </span>
          <span class="cover__title">Rithwik</span>
          <span class="cover__sub">Bird Feeds &amp; Industries</span>
          <span class="cover__place">Kurnool, Andhra Pradesh</span>
          <span class="cover__since">Trading grain since 1925</span>
          <span class="cover__open">Open the book</span>
        </button>
        <a class="cover__back page page--bird" href="#bird-feeds" data-enter="bird" tabindex="-1">
          <div class="page__inner">
            <svg class="page__flock" data-flock="6" viewBox="0 0 400 300" aria-hidden="true"></svg>
            <Image class="page__emblem page__emblem--bird" src={birdLogo} alt="" width={260} loading="eager" />
            <div class="page__text">
              <p class="page__kicker">Rithwik Bird Feeds</p>
              <h2 class="page__title">Bird<br />feeds</h2>
              <p class="page__lede">Foxtail, proso, sunflower, jowar and more, cleaned for cage birds and aviaries.</p>
              <span class="page__count">{nBird} feed lines</span>
              <span class="page__cta">Open Bird Feeds</span>
            </div>
            <span class="page__folio" aria-hidden="true">i</span>
          </div>
        </a>
      </div>
      <span class="book__shadow" aria-hidden="true"></span>
    </div>

    <p class="stage__direct">Go straight to <a href="#bird-feeds" data-enter="bird">Bird Feeds</a> or <a href="#human-food" data-enter="food">Human Food</a></p>
  </section>

  <div class="turn" id="turn" aria-hidden="true"></div>


  <!-- ================= SITE 1: RITHWIK BIRD FEEDS ================= -->
  <div class="site site--bird" id="bird-feeds" data-site="bird" hidden>
    <SiteHeader logo={birdLogo} first="Rithwik" second="Bird Feeds" top="b-top" email={BRANDS.bird.email}
      phones={[CONTACT.phones[1], CONTACT.phones[2]]}
      links={[{ href: 'b-about', label: 'About' }, { href: 'b-packs', label: 'Packs' }, { href: 'b-birds', label: 'Birds' }, { href: 'b-feeds', label: 'Feeds' }, { href: 'b-vision', label: 'Vision' }, { href: 'b-contact', label: 'Contact' }]} />

    <main>
      <section class="bird__hero" id="b-top" aria-labelledby="bird-title">
        {birdHeroPhoto && (
          <div class="bird__photo" data-parallax="0.18">
            <Photo name="bird-budgies" alt="" sizes="(max-width: 860px) 100vw, 58vw" eager />
          </div>
        )}
        <canvas class="seedfall" aria-hidden="true"></canvas>
        <svg class="bird__flock" data-flock="11" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true"></svg>
        <span class="ghost ghost--bird" data-ghost="Feeds" aria-hidden="true"></span>
        <div class="bird__intro bird__intro--pack">
          <div class="bird__copy">
            <h1 class="display" id="bird-title" data-split><span class="display__a">Rithwik</span> <span class="display__b">Bird feeds</span></h1>
            <p class="bird__lede" data-rise>Seventeen feed lines, sold raw or cleaned, from our office in Kurnool and our warehouse at Duvvur.</p>
            <div class="actions" data-rise>
              <a class="pill pill--gold" href="#b-feeds" data-jump data-magnetic>See the feeds</a>
              <a class="pill pill--line" href={`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent('Hello Rithwik Bird Feeds, I would like a price.')}`} target="_blank" rel="noopener">WhatsApp an order</a>
            </div>
          </div>
          <HeroPack kind="sack" logo={birdLogo.src} items={BIRD_PACKS} />
        </div>
        <span class="scrollcue" aria-hidden="true"></span>
      </section>

      <div class="facts" aria-label="Rithwik Bird Feeds at a glance">
        <div class="fact"><b data-count={nBird}>{nBird}</b><span>feed lines</span></div>
        <div class="fact"><b>Summer &amp; winter</b><span>foxtail crops, raw or cleaned</span></div>
        <div class="fact"><b>Since 1925</b><span>a family grain trade</span></div>
        <div class="fact fact--code"><b>{BRANDS.bird.gstin}</b><span>GSTIN</span></div>
      </div>

      <section class="about about--bird" id="b-about" aria-labelledby="b-about-title">
        <div class="about__copy">
          <h2 class="section-title" id="b-about-title" data-split>Who we are</h2>
          <p class="about__lead" data-reveal>Rithwik Bird Feeds carries forward a family grain trade that began in 1925.</p>
          <p data-reveal>We bring in millets, sunflower, jowar, maize and horse gram, clean and sort them at our Duvvur warehouse, and supply them raw or cleaned to traders, pet shops and bird keepers. Foxtail comes from both the summer and winter crops, and white proso goes through a Sortex colour sorter.</p>
        </div>
        <div class="about__media">
          {birdAboutPhoto && (
            <figure class="about__photo about__photo--main" data-curtain>
              <Photo name="bird-on-millet" alt="A rosefinch feeding on a ripe millet head" sizes="(max-width: 860px) 92vw, 46vw" />
            </figure>
          )}
          {birdFlightPhoto && (
            <figure class="about__photo about__photo--small" data-parallax="-0.12">
              <Photo name="bird-parakeet-flight" alt="A rose-ringed parakeet carrying a sunflower head" sizes="(max-width: 860px) 34vw, 260px" />
            </figure>
          )}
        </div>
      </section>

      <Legacy tone="bird" />

      <PackStudio id="b-packs" kind="sack" tone="bird" logo={birdLogo.src} items={BIRD_PACKS} contact="b-contact"
        title="Our packs" lede="Every feed line in its own Rithwik sack. Pick a feed and the pack turns to show it." />

      <BirdsWeFeed id="b-birds" />

      <div class="marquee marquee--bird" aria-hidden="true"><div class="marquee__track">
        {[0, 1].map(() => marquee(BIRD.map((b) => b.name)).map((n) => <span>{n}</span>))}
      </div></div>

      <section class="feeds" id="b-feeds" aria-labelledby="b-feeds-title">
        <div class="feeds__head">
          <h2 class="section-title" id="b-feeds-title" data-split>The feeds</h2>
          <p>Prices change with the crop, so we quote on request. Pick the option you want on a card, then tap <em>Ask price</em> and it goes straight into the order form.</p>
        </div>
        <div class="chips" role="group" aria-label="Filter feeds">
          <button class="chip is-on" type="button" data-filter="all" aria-pressed="true">All feeds</button>
          {BIRD_GROUPS.map((g) => <button class="chip" type="button" data-filter={g.id} aria-pressed="false">{g.label}</button>)}
        </div>
        <div class="pgrid">
          {BIRD.map((p) => <ProductCard product={p} contact="b-contact" tone="bird" />)}
        </div>
      </section>

      <SeasonClock id="b-seasons" tone="bird" crops={BIRD_SEASONS} title="Season clock"
        lede="Each ring is a feed grain; its arc shows the months it usually comes in. The hand points at today. Step through the year to plan your buying." />

      <SeedToSack id="b-story" tone="bird" title="Seed to sack" packWord="sacks"
        lede="What happens between the farm and your shop. Scroll to follow the grain." />

      <Vision id="b-vision" tone="bird"
        vision="Kurnool's bird feed in aviaries and pet stores around the world."
        mission="Clean, sort and pack every feed line to one standard, keep prices fair through the seasons, and build the certifications and shipping partners we need to export."
        image="port-ship" imageAlt="A container ship leaving port" />

      <Certifications id="b-certs" tone="bird" regs={held('bird')} photo="bird-plumhead" photoAlt="A plum-headed parakeet feeding" />

      <Steps id="b-order" tone="bird" steps={[
        { title: 'Pick your feeds', body: 'Choose from the cards above. Say if you want it raw or cleaned, and which foxtail crop.' },
        { title: 'Send it on WhatsApp', body: 'Use the form below or message 83097 82770 with the quantity and your town.' },
        { title: "Get today's price", body: 'We reply with the current rate and work out packing and delivery with you.' },
      ]} />

      <Contact id="b-contact" tone="bird" brand={BRANDS.bird.name} email={BRANDS.bird.email} options={birdOptions}
        label="Feed" qtyHint="For example, 50 bags or 2 tonnes" msgHint="Delivery town, raw or cleaned, packing" />
    </main>

    <Footer logo={birdLogo} tone="bird" brand={BRANDS.bird.name} gstin={BRANDS.bird.gstin}
      sister={{ view: 'food', href: '#human-food', text: 'Rithwik Industries, millets, seeds and dals for people' }} />
    <svg class="scrollbird" viewBox="-40 -24 80 48" aria-hidden="true"><path d="M-32 -9 Q-17 -17 0 2 Q17 -17 32 -9 Q17 -8 0 7 Q-17 -8 -32 -9Z" /></svg>
  </div>


  <!-- ================= SITE 2: RITHWIK INDUSTRIES ================= -->
  <div class="site site--food" id="human-food" data-site="food" hidden>
    <SiteHeader logo={foodLogo} first="Rithwik" second="Industries" top="f-top" email={BRANDS.food.email}
      phones={[CONTACT.phones[0], CONTACT.phones[3]]}
      links={[{ href: 'f-about', label: 'About' }, { href: 'f-packs', label: 'Packs' }, { href: 'f-range', label: 'Products' }, { href: 'f-vision', label: 'Vision' }, { href: 'f-contact', label: 'Contact' }]} />

    <main>
      <section class="food-hero" id="f-top" aria-labelledby="food-title">
        <span class="ghost ghost--food" data-ghost="Grain" aria-hidden="true"></span>
        <div class="food-hero__copy">
          <p class="food-hero__brand" data-rise>Rithwik Industries</p>
          <h1 class="display display--food" id="food-title" data-split>Nature's grain, nurtured for you</h1>
          <p class="food-hero__lede" data-rise>Millets, super seeds, quinoa, dals and spices for homes, shops and bulk buyers.</p>
          <div class="actions" data-rise>
            <a class="pill pill--ink" href="#f-range" data-jump data-magnetic>Browse the range</a>
            <a class="pill pill--line-ink" href={`${base}Rithwik-Catalogue.pdf`} download>Download catalogue (PDF)</a>
          </div>
          <ul class="trust" data-rise aria-label="Certifications">
            {held('food').filter((r) => r.mark !== 'GST').map((r) => (
              <li><a href="#f-certs" data-jump><span class="trust__mark">{r.mark}</span><span>{r.status}</span></a></li>
            ))}
          </ul>
        </div>
        <div class="food-hero__art food-hero__art--pack">
          <canvas class="grainpour" aria-hidden="true"></canvas>
          <HeroPack kind="pouch" logo={foodLogo.src} items={FOOD_PACKS} />
        </div>
      </section>

      <div class="marquee marquee--food" aria-hidden="true"><div class="marquee__track">
        {[0, 1].map(() => marquee(FOOD.map((f) => f.name)).map((n) => <span>{n}</span>))}
      </div></div>

      <section class="about about--food" id="f-about" aria-labelledby="f-about-title">
        <div class="about__copy">
          <h2 class="section-title section-title--food" id="f-about-title" data-split>Who we are</h2>
          <p class="about__lead" data-reveal>Rithwik Industries carries forward a family grain trade that began in 1925, bringing millets, super seeds and pulses to homes, shops and bulk buyers.</p>
          <p data-reveal>We work from our office in Kurnool and our warehouse at Duvvur, keeping six millets, ten seeds and super foods, and a shelf of dals, pulses and whole spices. Tell us the pack size you need and we'll quote for it.</p>
        </div>
        <div class="about__media">
          {farmersPhoto && (
            <figure class="about__photo about__photo--main" data-curtain>
              <Photo name="farmers-millet" alt="Farmers standing in a tall pearl millet field" sizes="(max-width: 860px) 92vw, 46vw" />
            </figure>
          )}
        </div>
      </section>

      <Legacy tone="food" />

      <PackStudio id="f-packs" kind="pouch" tone="food" logo={foodLogo.src} items={FOOD_PACKS} contact="f-contact"
        title="Our packs" lede="Kraft pouches with a clear window, so you can see the grain. Pick a product to turn the pack." />

      <div id="f-range">
        {FOOD_GROUPS.map((g) => (
          <section class="range" id={`f-${g.id}`} aria-labelledby={`f-${g.id}-title`}>
            {scenes[g.id] && (
              <figure class="range__banner" data-curtain>
                <Photo name={scenes[g.id]} alt="" sizes="(max-width: 1240px) 100vw, 1240px" />
              </figure>
            )}
            <div class="range__head">
              <h2 class="section-title section-title--food" id={`f-${g.id}-title`} data-split>{g.label}</h2>
              <p>{g.note}</p>
            </div>
            <div class="pgrid">
              {FOOD.filter((p) => p.group === g.id).map((p) => <ProductCard product={p} contact="f-contact" tone="food" />)}
            </div>
          </section>
        ))}
      </div>

      <div class="facts facts--food" aria-label="Rithwik Industries at a glance">
        <div class="fact"><b data-count={nFood}>{nFood}</b><span>products on the list</span></div>
        <div class="fact"><b>Kurnool</b><span>office, near Nandyal Checkpost</span></div>
        <div class="fact"><b>Since 1925</b><span>a family grain trade</span></div>
        <div class="fact fact--code"><b>{BRANDS.food.gstin}</b><span>GSTIN</span></div>
      </div>

      <SeedToSack id="f-story" tone="food" title="Field to pack" packWord="bags and pouches"
        lede="What happens between the farm and your kitchen. Scroll to follow the grain." />

      <SeasonClock id="f-seasons" tone="food" crops={FOOD_SEASONS} title="Season clock"
        lede="Each ring is a crop; its arc shows the months it usually comes in. The hand points at today. Step through the year to see what's fresh." />

      <Vision id="f-vision" tone="food"
        vision="Indian millets and super seeds on kitchen shelves across the world."
        mission="Source directly from Andhra Pradesh farmers, clean and pack with care, and meet the food-safety and export standards that overseas buyers expect."
        image="port-ship" imageAlt="A container ship leaving port" />

      <Certifications id="f-certs" tone="food" regs={held('food')} photo="quinoab" photoAlt="White, red and black quinoa" />

      <Steps id="f-order" tone="food" steps={[
        { title: 'Choose your products', body: 'Pick from millets, seeds, quinoa, dals and spices above.' },
        { title: 'Tell us the quantity', body: 'Use the form below or message 83097 82770 with how much you need and where.' },
        { title: 'Get a quote', body: "We reply with today's price and agree packing and delivery with you." },
      ]} />

      <Contact id="f-contact" tone="food" brand={BRANDS.food.name} email={BRANDS.food.email} options={foodOptions}
        label="Product" qtyHint="For example, 25 kg or 1 tonne" msgHint="Delivery town, packing size" />
    </main>

    <Footer logo={foodLogo} tone="food" brand={BRANDS.food.name} gstin={BRANDS.food.gstin}
      sister={{ view: 'bird', href: '#bird-feeds', text: 'Rithwik Bird Feeds, grains and seed for birds' }} />
  </div>

  <dialog class="credits" id="credits">
    <h2>Photo credits</h2>
    <p>Product and scene photos are from Wikimedia Commons, used under the licences below. Logos and catalogue belong to Rithwik.</p>
    <ul>
      {credits.map((c) => <li><a href={c.source} target="_blank" rel="noopener">{c.title}</a>{c.author && `, ${c.author}`}, {c.license}</li>)}
    </ul>
    <form method="dialog"><button class="pill pill--gold">Close</button></form>
  </dialog>

  <div class="sound" data-sound>
    <button class="sound__btn" type="button" aria-pressed="false" data-sound-toggle>
      <svg class="sound__icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" />
        <g class="sound__waves" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M15.5 9.2a4 4 0 0 1 0 5.6" /><path d="M18 6.8a7.5 7.5 0 0 1 0 10.4" /></g>
        <path class="sound__mute" d="M15.5 9.5l5 5m0-5l-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <span class="sound__label" data-sound-label>Birdsong off</span>
    </button>
    <span class="sound__nudge" data-sound-nudge hidden>Tap to hear the birds</span>
  </div>

  <a class="wa" href={`https://wa.me/${CONTACT.whatsapp}`} target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
    <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.6a10.6 10.6 0 0 1-5.4-1.5l-.4-.2-3.9 1 1-3.8-.2-.4A10.6 10.6 0 1 1 16 26.6Zm5.8-7.9c-.3-.2-1.9-.9-2.2-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.7 8.7 0 0 1-4.3-3.8c-.3-.6.3-.5 1-1.7.1-.2 0-.4 0-.6l-1-2.3c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.7 3.7 0 0 0-1.1 2.7 6.4 6.4 0 0 0 1.3 3.4 14.7 14.7 0 0 0 5.6 5c2.1.9 2.9 1 4 .8a3.4 3.4 0 0 0 2.2-1.6 2.8 2.8 0 0 0 .2-1.6c-.1-.1-.3-.2-.6-.3Z" /></svg>
  </a>

  <script>
    import '../scripts/main.ts';
  </script>
</body>
</html>
