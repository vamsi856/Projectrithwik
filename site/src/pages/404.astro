---
import { Image } from 'astro:assets';
import birdLogo from '../assets/brand/birdfeeds-emblem.jpg';
import foodLogo from '../assets/brand/industries-emblem.png';
import { BRANDS } from '../data/products';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Page not found, Rithwik</title>
  <meta name="description" content="This page isn't here. Visit Rithwik Bird Feeds or Rithwik Industries, Kurnool." />
  <meta name="robots" content="noindex" />
  <meta name="theme-color" content="#0b1924" />
  <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
  <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <style is:global>
    @font-face { font-family: Anton; src: url('/Projectrithwik/fonts/anton-latin-400-normal.woff2') format('woff2'); font-display: swap; }
    @font-face { font-family: 'Instrument Sans'; src: url('/Projectrithwik/fonts/instrument-sans-latin-400-normal.woff2') format('woff2'); font-weight: 400; font-display: swap; }
    @font-face { font-family: 'Instrument Sans'; src: url('/Projectrithwik/fonts/instrument-sans-latin-600-normal.woff2') format('woff2'); font-weight: 600; font-display: swap; }
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; overflow-x: hidden; }
    body {
      min-height: 100vh; min-height: 100svh; display: grid; place-items: center; padding: 32px 16px;
      background: radial-gradient(120% 90% at 50% 0%, #17324a 0%, #0b1924 60%); color: #f4eddb;
      font: 400 1.05rem/1.6 'Instrument Sans', system-ui, sans-serif; text-align: center;
    }
    main { width: min(640px, 100%); }
    .logos { display: flex; justify-content: center; gap: 18px; margin-bottom: 26px; }
    .logos a { display: block; width: 92px; height: 92px; border-radius: 50%; overflow: hidden; background: #f4eddb; box-shadow: 0 10px 30px -10px rgba(0,0,0,.6); transition: transform .3s; }
    .logos a:hover { transform: translateY(-4px) rotate(-3deg); }
    .logos img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 32%; }
    .logos a + a img { object-fit: contain; padding: 6px; object-position: 50% 30%; }
    .code { font: 400 clamp(5rem, 22vw, 9rem)/.9 Anton, Impact, sans-serif; color: #f2b21b; letter-spacing: .02em; margin: 0; }
    h1 { font: 400 clamp(1.6rem, 6vw, 2.4rem)/1.1 Anton, Impact, sans-serif; text-transform: uppercase; letter-spacing: .02em; margin: 6px 0 12px; }
    p { margin: 0 auto 26px; max-width: 34em; opacity: .85; }
    .go { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
    .go a { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 10px 22px; border-radius: 999px; font-weight: 600; text-decoration: none; border: 1.5px solid #f4eddb; color: #f4eddb; }
    .go a:hover { background: rgba(244,237,219,.1); }
    .go .bird { background: #f2b21b; border-color: #f2b21b; color: #0b1924; }
    .go .bird:hover { background: #ffc53a; }
    .go .food { background: #f4eddb; color: #1c2533; }
    .go .food:hover { background: #fff; }
    .go a:focus-visible, .logos a:focus-visible { outline: 3px solid #7cc4ea; outline-offset: 3px; }
    .reach { margin: 30px 0 0; font-size: .95rem; opacity: .75; }
    .reach a { color: inherit; font-weight: 600; overflow-wrap: anywhere; }
    @media (max-width: 420px) { .go a { flex: 1 1 100%; } }
  </style>
</head>
<body>
  <main>
    <div class="logos">
      <a href={`${base}#bird-feeds`} aria-label="Rithwik Bird Feeds"><Image src={birdLogo} alt="" width={184} /></a>
      <a href={`${base}#human-food`} aria-label="Rithwik Industries"><Image src={foodLogo} alt="" width={184} /></a>
    </div>
    <p class="code" aria-hidden="true">404</p>
    <h1>This page flew off</h1>
    <p>The link may be old or mistyped. Everything we sell is on one of our two sites.</p>
    <nav class="go" aria-label="Where to go">
      <a class="bird" href={`${base}#bird-feeds`}>Rithwik Bird Feeds</a>
      <a class="food" href={`${base}#human-food`}>Rithwik Industries</a>
      <a href={base}>Open the book</a>
    </nav>
    <p class="reach">Or call <a href="tel:+918309782770">83097 82770</a>, WhatsApp <a href="https://wa.me/918309782770">83097 82770</a>, or email <a href={`mailto:${BRANDS.bird.email}`}>{BRANDS.bird.email}</a> / <a href={`mailto:${BRANDS.food.email}`}>{BRANDS.food.email}</a></p>
  </main>
</body>
</html>
