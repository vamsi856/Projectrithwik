---
import Photo from './Photo.astro';
import type { Product } from '../data/products';
import { lineName, axesLabel } from '../data/products';
import { photo } from '../data/photos';

interface Props { product: Product; contact: string; tone: 'bird' | 'food' }
const { product: p, contact, tone } = Astro.props;
const img = photo(p.photo);
const multi = p.variants.length > 1;
const axes = p.axes ?? [];
// with axes, the first option on each axis is picked to start with
const first = axes.length ? { label: axesLabel(axes.map((a) => a.options[0])), gst: p.variants[0].gst } : p.variants[0];
const brand = tone === 'food' ? 'Rithwik Industries' : 'Rithwik Bird Feeds';
const wa = (line: string) => `https://wa.me/918309782770?text=${encodeURIComponent(`Hello ${brand}, I would like to order: ${line}. Please share the price and availability.`)}`;
const swatch = `--c1:${p.swatch.c1};--c2:${p.swatch.c2};--g:${p.swatch.grain}px`;
---
<article class:list={['pcard', `pcard--${tone}`]} data-group={p.group} data-card data-name={axes.length ? p.name : undefined}>
  <div class="pcard__media">
    {img ? (
      <Photo name={p.photo!} class="pcard__img" alt={p.name} sizes="(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 380px" />
    ) : (
      <div class="pcard__plate"><span class="seed seed--plate" style={swatch} aria-hidden="true"></span></div>
    )}
    <span class="seed pcard__swatch" style={swatch} aria-hidden="true"></span>
  </div>
  <div class="pcard__body">
    <h3 class="pcard__name">{p.name}</h3>
    {axes.length ? (
      <div class="axes">
        {axes.map((a, ai) => (
          <fieldset class="variants variants--axis" data-axis>
            <legend class="axes__name">{a.name}</legend>
            {a.options.map((o, i) => (
              <label class="variant">
                <input type="radio" name={`v-${p.id}-${ai}`} value={o} checked={i === 0} />
                <span>{o}</span>
              </label>
            ))}
          </fieldset>
        ))}
      </div>
    ) : multi ? (
      <fieldset class="variants">
        <legend class="sr">{p.name} options</legend>
        {p.variants.map((v, i) => (
          <label class="variant">
            <input type="radio" name={`v-${p.id}`} value={lineName(p, v)} checked={i === 0} />
            <span>{v.label}</span>
          </label>
        ))}
      </fieldset>
    ) : (
      first.label && <p class="pcard__note">{first.label}</p>
    )}
    <div class="pcard__foot">
      <a class="pcard__ask" href={`#${contact}`} data-product={lineName(p, first)}>Ask price</a>
      <a class="pcard__wa" href={wa(lineName(p, first))} target="_blank" rel="noopener" data-wa={brand} aria-label={`Order ${p.name} on WhatsApp`}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3a.5.5 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.2c0-.1-.2-.2-.4-.3Z"/></svg>
        Order
      </a>
    </div>
  </div>
</article>
