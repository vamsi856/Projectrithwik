---
// A plain, crawlable list of products by group, with photo, options and local names.
import Photo from './Photo.astro';
import type { Product } from '../data/products';
import { LOCAL_NAMES } from '../data/local-names';
interface Props { items: Product[]; groups: readonly { id: string; label: string; note?: string }[]; brand: string }
const { items, groups, brand } = Astro.props;
const options = (p: Product) => p.axes?.length ? p.axes.flatMap((a) => a.options) : p.variants.map((v) => v.label).filter(Boolean);
---
{groups.map((g, gi) => {
  const ps = items.filter((p) => p.group === g.id);
  return ps.length > 0 && (
    <section aria-labelledby={`g-${g.id}`}>
      <h2 id={`g-${g.id}`}>{g.label}</h2>
      {g.note && <p>{g.note}</p>}
      <div class="igrid">
        {ps.map((p, i) => (
          <article class="icard">
            <Photo name={p.variants[0]?.photo || p.photo || ''} alt={`${p.name} from ${brand}, Kurnool`} sizes="(max-width: 600px) 92vw, 280px" eager={gi === 0 && i < 4} />
            <div class="icard__body">
              <h3>{p.name}</h3>
              {LOCAL_NAMES[p.name] && <p>{LOCAL_NAMES[p.name]}</p>}
              {options(p).length > 0 && <ul class="itags" aria-label="Options">{options(p).map((o) => <li>{o}</li>)}</ul>}
            </div>
          </article>
        ))}
      </div>
    </section>
  );
})}
