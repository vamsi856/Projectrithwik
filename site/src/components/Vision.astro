---
import Photo from './Photo.astro';
import IndiaMap from './IndiaMap.astro';
import { photo } from '../data/photos';
interface Props { id: string; tone: 'bird' | 'food'; vision: string; mission: string | string[]; goal?: string; image?: string; imageAlt?: string }
const { id, tone, vision, mission, goal, image, imageAlt = '' } = Astro.props;
const missionParas = Array.isArray(mission) ? mission : [mission];
const img = photo(image);
---
<section class:list={['vision', `vision--${tone}`]} id={id} aria-labelledby={`${id}-title`}>
  <div class="vision__map">
    <IndiaMap tone={tone} id={`${id}-map`} />
  </div>
  <div class="vision__copy">
    <h2 class="section-title" id={`${id}-title`} data-split>From Kurnool to the world</h2>
    <div class="vm">
      <div class="vm__item" data-reveal>
        <h3>Our vision</h3>
        <p>{vision}</p>
      </div>
      <div class="vm__item" data-reveal>
        <h3>Our mission</h3>
        {missionParas.map((m) => <p>{m}</p>)}
      </div>
      {goal && (
        <div class="vm__item vm__item--goal" data-reveal>
          <h3>Our goal is simple</h3>
          <p>{goal}</p>
        </div>
      )}
    </div>
    <p class="vision__where" data-reveal>Where we're heading next: the Gulf, Europe, East and Southeast Asia, and North America.</p>
    {img && (
      <figure class="vision__photo" data-curtain>
        <Photo name={image!} alt={imageAlt} sizes="(max-width: 860px) 92vw, 560px" />
      </figure>
    )}
  </div>
</section>
