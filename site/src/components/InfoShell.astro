---
// The frame of the plain information pages: head (title, description, canonical, share tags, structured data),
// a header with both logos and the page menu, and a footer with contact details. Cream, ink and bronze,
// with the Bird Feeds marigold as the accent, so it sits between the two sites.
import '../styles/info.css';
import { Image } from 'astro:assets';
import birdLogo from '../assets/brand/birdfeeds-emblem.jpg';
import foodLogo from '../assets/brand/industries-emblem.png';
import { BRANDS, CONTACT } from '../data/products';
import { INFO_PAGES, infoPage } from '../data/pages';
import { PATHS } from '../data/seo';
interface Props { path: string; h1: string; lede?: string; schema?: Record<string, unknown>[] }
const { path, h1, lede, schema = [] } = Astro.props;
const page = infoPage(path);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const SITE = new URL(base, Astro.site).href;
const url = `${SITE}${path}`;
const ogImage = new URL(`${base}${path.startsWith('bird') ? 'og-bird.jpg' : path.startsWith('human') ? 'og-food.jpg' : 'og.jpg'}`, Astro.site).href;
// breadcrumb: Home > (Bird Feeds / Human Food) > this page
const trail = [{ name: 'Home', item: SITE }];
if (path.startsWith('bird-feeds/')) trail.push({ name: BRANDS.bird.name, item: `${SITE}${PATHS.bird}` });
if (path.startsWith('human-food/')) trail.push({ name: BRANDS.food.name, item: `${SITE}${PATHS.food}` });
trail.push({ name: page.label, item: url });
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebPage', '@id': `${url}#page`, url, name: page.title, description: page.description, inLanguage: 'en-IN', isPartOf: { '@id': `${SITE}#site` }, publisher: { '@id': `${SITE}#family` }, breadcrumb: { '@id': `${url}#crumbs` } },
    { '@type': 'BreadcrumbList', '@id': `${url}#crumbs`, itemListElement: trail.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.name, item: t.item })) },
    ...schema,
  ],
};
const fonts = [['Anton', 400, 'anton-latin-400-normal'], ...[400, 600, 700].map((w) => ['Instrument Sans', w, `instrument-sans-latin-${w}-normal`])]
  .map(([f, w, file]) => `@font-face { font-family: "${f}"; src: url("${base}fonts/${file}.woff2") format("woff2"); font-weight: ${w}; font-display: swap; }`).join('\n');
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <script is:inline define:vars={{ home: new URL(Astro.site!).origin }}>
    if (location.origin !== home && /\.github\.io$/.test(location.hostname)) location.replace(home + (location.pathname.replace(/^\/Projectrithwik(?=\/|$)/, '') || '/') + location.search + location.hash);
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{page.title}</title>
  <meta name="description" content={page.description} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  <meta name="theme-color" content="#e4dfc1" />
  <link rel="canonical" href={url} />
  <link rel="alternate" hreflang="en-IN" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:site_name" content="Rithwik, Kurnool" />
  <meta property="og:title" content={page.title} />
  <meta property="og:description" content={page.description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
  <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
  <link rel="manifest" href={`${base}site.webmanifest`} />
  <link rel="preload" href={`${base}fonts/anton-latin-400-normal.woff2`} as="font" type="font/woff2" crossorigin />
  <style is:inline set:html={fonts}></style>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body class="info">
  <header class="ihead">
    <div class="ihead__bar">
      <a class="ihead__brand" href={base} aria-label="Rithwik, home">
        <Image src={birdLogo} alt="" width={44} height={44} loading="eager" />
        <Image src={foodLogo} alt="" width={44} height={44} loading="eager" />
        <span>Rithwik <b>Kurnool</b></span>
      </a>
      <a class="ihead__call" href={`tel:${CONTACT.call.tel}`}>Call {CONTACT.call.label}</a>
    </div>
    <nav class="inav" aria-label="Pages">
      <a href={`${base}${PATHS.bird}`}>Bird Feeds</a>
      <a href={`${base}${PATHS.food}`}>Human Food</a>
      {INFO_PAGES.map((p) => <a href={`${base}${p.path}`} aria-current={p.path === path ? 'page' : undefined}>{p.label}</a>)}
    </nav>
  </header>

  <main class="imain">
    <nav class="crumbs" aria-label="Breadcrumb">
      {trail.map((t, i) => i < trail.length - 1 ? <><a href={t.item.replace(new URL(Astro.site!).origin, '')}>{t.name}</a><span aria-hidden="true"> / </span></> : <span aria-current="page">{t.name}</span>)}
    </nav>
    <h1 class="ititle">{h1}</h1>
    {lede && <p class="ilede">{lede}</p>}
    <slot />
  </main>

  <aside class="iask">
    <h2>Ask for today's price</h2>
    <p>Tell us the product, the quantity and your town. We reply on WhatsApp with the day's rate.</p>
    <p class="iask__btns">
      <a class="ibtn ibtn--wa" href={`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent('Hello Rithwik,')}`} target="_blank" rel="noopener">WhatsApp {CONTACT.call.label}</a>
      <a class="ibtn" href={`tel:${CONTACT.call.tel}`}>Call {CONTACT.call.label}</a>
    </p>
  </aside>

  <footer class="ifoot">
    <nav class="ifoot__links" aria-label="All pages">
      <a href={base}>Home</a>
      <a href={`${base}${PATHS.bird}`}>{BRANDS.bird.name}</a>
      <a href={`${base}${PATHS.food}`}>{BRANDS.food.name}</a>
      {INFO_PAGES.map((p) => <a href={`${base}${p.path}`}>{p.label}</a>)}
    </nav>
    <p>{CONTACT.office}. Phone and WhatsApp {CONTACT.call.label}. <a href={`mailto:${BRANDS.bird.email}`}>{BRANDS.bird.email}</a> · <a href={`mailto:${BRANDS.food.email}`}>{BRANDS.food.email}</a></p>
    <p class="ifoot__small">&copy; {year} Rithwik Bird Feeds (GSTIN {BRANDS.bird.gstin}) and Rithwik Industries (GSTIN {BRANDS.food.gstin}), Kurnool.</p>
  </footer>
</body>
</html>
