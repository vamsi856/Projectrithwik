---
// Inside Rithwik: the family's own photos of the warehouse and the sack.
// Images are optimised at build time (astro:assets).
import { Image } from 'astro:assets';
import warehouse from '../assets/plant/warehouse.jpg';
import sack from '../assets/plant/sack.jpg';
interface Props { tone: 'bird' | 'food'; id: string }
const { tone, id } = Astro.props;
---
<section class:list={['plant', `plant--${tone}`]} id={id} aria-labelledby={`${id}-title`}>
  <header class="plant__head">
    <p class="plant__kicker">Inside Rithwik</p>
    <h2 class:list={['section-title', tone === 'food' && 'section-title--food']} id={`${id}-title`} data-split>Where your grain waits</h2>
    <p class="plant__lede">Every lot is cleaned, weighed and packed at our own warehouse at Duvvur before it leaves for you. These are our photos, not stock.</p>
  </header>
  <div class:list={['plant__grid', tone === 'bird' ? 'plant__grid--two' : 'plant__grid--one']}>
    <figure class="plant__fig plant__fig--warehouse" data-curtain>
      <Image src={warehouse} alt="The Rithwik warehouse at Duvvur, with the Rithwik Bird Feeds signboard on the wall" widths={[640, 1000, 1156]} sizes="(max-width: 860px) 92vw, 70vw" loading="lazy" />
      <figcaption><b>Our warehouse</b><span>Duvvur, YSR district</span></figcaption>
    </figure>
    {tone === 'bird' && (
      <figure class="plant__fig plant__fig--sack" data-curtain>
        <Image src={sack} alt="A filled 50 kg Rithwik Birds Feeds India sack of Super Fine Millets" widths={[400, 700]} sizes="(max-width: 860px) 92vw, 26vw" loading="lazy" />
        <figcaption><b>The 50 kg sack</b><span>Super Fine Millets</span></figcaption>
      </figure>
    )}
  </div>
</section>
