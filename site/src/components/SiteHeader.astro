---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CONTACT } from '../data/products';
interface Props {
  logo: ImageMetadata; first: string; second: string; top: string;
  links: { href: string; label: string }[]; email: string; phones: { tel: string; label: string }[];
  sister: { view: string; href: string; text: string };
}
const { logo, first, second, top, links, email, phones, sister } = Astro.props;
const navId = `${top}-nav`;
const wa = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(`Hello ${first} ${second},`)}`;
---
<div class="strip">
  <a href={`mailto:${email}`}>{email}</a>
  {phones.map((p) => <a href={`tel:${p.tel}`}>{p.label}</a>)}
</div>
<header class="sbar">
  <a class="sbar__brand" href={`#${top}`} data-jump aria-label={`${first} ${second}, back to the top`}>
    <Image src={logo} alt="" width={88} height={88} />
    <span>{first} <b>{second}</b></span>
  </a>
  <nav class="sbar__nav" id={navId} aria-label={`${first} ${second}`} data-lenis-prevent>
    {links.map((l) => <a href={`#${l.href}`} data-jump data-nav={l.href}>{l.label}</a>)}
    <!-- phones only: the menu also carries the ways to reach us and the way out -->
    <div class="sbar__more">
      <a class="sbar__more-call" href="tel:+918309782770">Call 83097 82770</a>
      <a class="sbar__more-wa" href={wa} target="_blank" rel="noopener">WhatsApp us</a>
      <a class="sbar__more-mail" href={`mailto:${email}`}>{email}</a>
      <a class="sbar__more-sister" href={sister.href} data-switch={sister.view}>Visit {sister.text}</a>
      <a class="sbar__more-book" href="#" data-book>Back to the book</a>
    </div>
  </nav>
  <a class="sbar__call" href="tel:+918309782770">Call 83097 82770</a>
  <a class="sbar__book" href="#" data-book><span>Back to the book</span></a>
  <button class="sbar__menu" type="button" aria-expanded="false" aria-controls={navId} data-menu>
    <span class="sr">Menu</span><i aria-hidden="true"></i>
  </button>
  <span class="sbar__progress" aria-hidden="true"></span>
</header>
