---
// "Questions buyers ask": an accordion near the end of each business page (data in src/data/faq.ts).
// The same questions go to search engines as FAQPage structured data from Site.astro.
import { CONTACT } from '../data/products';
import type { Faq } from '../data/faq';
interface Props { id: string; tone: 'bird' | 'food'; items: Faq[] }
const { id, tone, items } = Astro.props;
const brand = tone === 'food' ? 'Rithwik Industries' : 'Rithwik Bird Feeds';
// the phone number opens WhatsApp, email addresses open the mail app
const LINK = /(\d{5} \d{5}|[\w.]+@[\w.]+\.\w+)/;
const parts = (text: string) => text.split(LINK).map((t, i) => {
  if (i % 2 === 0) return { text: t };
  if (t.includes('@')) return { text: t, href: `mailto:${t}` };
  const p = CONTACT.phones.find((x) => x.label === t);
  const num = (p?.tel ?? `+91${t.replace(/\s/g, '')}`).replace(/^\+/, '');
  return { text: t, href: `https://wa.me/${num}?text=${encodeURIComponent(`Hello ${brand},`)}`, wa: true };
});
---
<section class:list={['faq', `faq--${tone}`]} id={id} aria-labelledby={`${id}-title`}>
  <div class="faq__head">
    <h2 class:list={['section-title', tone === 'food' && 'section-title--food']} id={`${id}-title`} data-split>Questions buyers ask</h2>
    <p data-reveal>Short answers to what {tone === 'food' ? 'packers and traders' : 'traders and shops'} ask us most. Anything else, ask us on WhatsApp.</p>
  </div>
  <div class="faq__list">
    {items.map((f, i) => (
      <details class="faq__item" name={`${id}-q`} open={i === 0}>
        <summary><h3>{f.q}</h3><span class="faq__icon" aria-hidden="true"></span></summary>
        <p>{parts(f.a).map((x) => x.href
          ? <a href={x.href} {...(x.wa ? { target: '_blank', rel: 'noopener', 'aria-label': `${x.text} on WhatsApp` } : {})}>{x.text}</a>
          : x.text)}</p>
      </details>
    ))}
  </div>
</section>
