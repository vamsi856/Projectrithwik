---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CONTACT } from '../data/products';
interface Props { logo: ImageMetadata; tone: 'bird' | 'food'; brand: string; gstin: string; email: string; top: string; sister: { view: string; href: string; text: string } }
const { logo, tone, brand, gstin, email, top, sister } = Astro.props;
// the year is written at build time and kept current by the page script
const year = new Date().getFullYear();
---
<footer class:list={['foot', tone === 'food' && 'foot--food']}>
  <a class="foot__home" href={`#${top}`} data-jump aria-label={`${brand}, back to the top`}>
    <Image class="foot__logo" src={logo} alt="" width={128} height={128} loading="lazy" />
  </a>
  <p><b>{brand}</b>, Kurnool, Andhra Pradesh. GSTIN {gstin}</p>
  <p class="foot__reach"><a href={`tel:${CONTACT.call.tel}`}>Call {CONTACT.call.label}</a> · <a href="https://wa.me/919245555556" target="_blank" rel="noopener">WhatsApp</a> · <a href={`mailto:${email}`}>{email}</a></p>
  <p class="foot__sister">Also from our family: <a href={sister.href} data-switch={sister.view}>{sister.text}</a></p>
  <p class="foot__small">&copy; <span data-year>{year}</span> {brand}. <a href="#" data-book>Back to the book</a> · <a href="#credits" data-credits>Photo credits</a></p>
</footer>
