# Response headers for the Cloudflare Worker (static assets). Not used by GitHub Pages.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=()

# file names that change with their content: keep them for a year
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# the macaw animation sheets and the sound recordings: big files that are replaced by adding a
# new name, not by overwriting, so a returning visitor's browser may keep them for a week
/birds/*
  Cache-Control: public, max-age=604800
/sound/*
  Cache-Control: public, max-age=604800
